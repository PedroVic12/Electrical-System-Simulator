---
// Layout e lógica principal da página Astro
const pageTitle = "Sistema Elétrico de Potência Interativo";
---

<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8" />
    <meta name="description" content="Sistema Elétrico de Potência Interativo com Astro e JavaScript" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    
    <!-- Script do Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Chart.js para os gráficos -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    
    <style is:global>
      :root {
        --color-primary: #0891b2;
        --color-primary-dark: #000000;
        --color-primary-light: #ffffff;
        --color-primary-border: #67e8f9;
        --color-text-dark: #4476c8;
        --color-text-medium: #475569;
        --color-text-light: #f8fafc;
        --color-bg-card: #e5e7eb;
        --color-bg-card-alt: #f8fafc;
        --color-border: #d1d5db;
        --color-zinc: #a1a1aa;
      }

      body {
        font-family: 'Inter', sans-serif;
        color: var(--color-text-medium);
        background-color: white;
        transition: background 0.7s ease-out;
      }

      .animate-on-scroll {
        opacity: 0;
        transform: translateY(20px);
        transition: opacity 0.6s ease-out, transform 0.7s ease-out;
        transition-delay: 0.2s;
      }

      .animate-on-scroll.is-visible {
        opacity: 1;
        transform: translateY(0);
      }

      .main-nav-btn {
        border-width: 2px;
        border-color: transparent;
        transition: all 0.3s ease;
      }

      .main-nav-btn.active {
        border-color: var(--color-primary-border);
        background-color: var(--color-primary-light);
        transform: scale(1.02);
        box-shadow: 0 4px 14px 0 rgba(8, 145, 178, 0.39);
      }

      .tab-btn.active {
        background-color: var(--color-primary);
        color: var(--color-text-light);
      }

      .component-btn.active {
        background-color: var(--color-primary);
        color: var(--color-text-light);
        transform: translateY(-2px);
        box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1);
      }

      .flow-arrow {
        font-size: 2rem;
        color: var(--color-zinc);
      }
      
      .content-section {
        display: none;
      }

      .content-section.active {
        display: block;
      }
    </style>
</head>
<body>
    <div id="app-root">
        <!-- O conteúdo da aplicação será renderizado aqui pelo JavaScript -->
    </div>

    <script>
	// Responsabilidade: Gerir os dados da aplicação de forma centralizada.
// Segue o Princípio da Responsabilidade Única (SRP).
export const model = {
    generationData: [
        { name: 'Hidrelétricas', description: 'Utilizam a força da água para girar turbinas e geradores. São uma fonte limpa e renovável, mas dependem de recursos hídricos.' },
        { name: 'Termelétricas', description: 'Queimam combustíveis fósseis ou biomassa para aquecer água, produzir vapor e girar turbinas. São flexíveis, mas emitem gases de efeito estufa.' },
        { name: 'Nucleares', description: 'Utilizam a fissão nuclear para gerar calor, que produz vapor para as turbinas. São eficientes e não emitem gases de efeito estufa, mas geram resíduos radioativos.' },
        { name: 'Eólicas', description: 'Convertem a energia do vento em eletricidade através de aerogeradores. São renováveis e limpas, mas intermitentes.' },
        { name: 'Solares', description: 'Convertem a luz do sol em eletricidade, seja por painéis fotovoltaicos (diretamente) ou por usinas termossolares. Também são renováveis e limpas, mas intermitentes.' }
    ],
    componentsData: [
        { name: 'Geradores', description: 'Convertem outras formas de energia (mecânica, térmica, etc.) em energia elétrica. São o coração das usinas.' },
        { name: 'Transformadores', description: 'Alteram os níveis de tensão da eletricidade. Elevam a tensão para a transmissão e a reduzem para a distribuição e consumo.' },
        { name: 'Linhas', description: 'Conduzem a energia através de cabos aéreos ou subterrâneos, formando as redes de transmissão e distribuição.' },
        { name: 'Disjuntores', description: 'Controlam o fluxo de energia e protegem o sistema contra falhas. Atuam como interruptores de grande porte.' },
        { name: 'Relés', description: 'Detectam condições anormais (curtos-circuitos) e acionam os disjuntores para isolar a falha e proteger o resto do sistema.' },
        { name: 'Barramentos', description: 'São barras condutoras que conectam vários circuitos em uma subestação, funcionando como um nó de distribuição de energia.' },
        { name: 'Reativos', description: 'Capacitores e Reatores são usados para controlar a tensão e compensar a potência reativa na rede, melhorando a eficiência e a estabilidade.' }
    ],
    chartData: {
        labels: ['Hidrelétrica', 'Termelétrica', 'Eólica', 'Solar', 'Nuclear & Outras'],
        data: [62, 20, 11, 5, 2],
        colors: ['#06b6d4', '#64748b', '#38bdf8', '#facc15', '#a8a29e']
    },
    getGenerationData() { return this.generationData; },
    getComponentsData() { return this.componentsData; },
    getChartData() { return this.chartData; }
};



        // --- 1. MODEL ---
        // Responsabilidade: Gerir os dados da aplicação. (SRP)
        const ElectricalSystemModel = (() => {
            let instance;
            function createInstance() {
                const generationData = [
                    { name: 'Hidrelétricas', description: 'Utilizam a força da água para girar turbinas e geradores. São uma fonte limpa e renovável, mas dependem de recursos hídricos.' },
                    { name: 'Termelétricas', description: 'Queimam combustíveis fósseis ou biomassa para aquecer água, produzir vapor e girar turbinas. São flexíveis, mas emitem gases de efeito estufa.' },
                    { name: 'Nucleares', description: 'Utilizam a fissão nuclear para gerar calor, que produz vapor para as turbinas. São eficientes e não emitem gases de efeito estufa, mas geram resíduos radioativos.' },
                    { name: 'Eólicas', description: 'Convertem a energia do vento em eletricidade através de aerogeradores. São renováveis e limpas, mas intermitentes.' },
                    { name: 'Solares', description: 'Convertem a luz do sol em eletricidade, seja por painéis fotovoltaicos (diretamente) ou por usinas termossolares. Também são renováveis e limpas, mas intermitentes.' }
                ];
                const componentsData = [
                    { name: 'Geradores', description: 'Convertem outras formas de energia (mecânica, térmica, etc.) em energia elétrica. São o coração das usinas.' },
                    { name: 'Transformadores', description: 'Alteram os níveis de tensão da eletricidade. Elevam a tensão para a transmissão e a reduzem para a distribuição e consumo.' },
                    { name: 'Linhas', description: 'Conduzem a energia através de cabos aéreos ou subterrâneos, formando as redes de transmissão e distribuição.' },
                    { name: 'Disjuntores', description: 'Controlam o fluxo de energia e protegem o sistema contra falhas. Atuam como interruptores de grande porte.' },
                    { name: 'Relés', description: 'Detectam condições anormais (curtos-circuitos) e acionam os disjuntores para isolar a falha e proteger o resto do sistema.' },
                    { name: 'Barramentos', description: 'São barras condutoras que conectam vários circuitos em uma subestação, funcionando como um nó de distribuição de energia.' },
                    { name: 'Reativos', description: 'Capacitores e Reatores são usados para controlar a tensão e compensar a potência reativa na rede, melhorando a eficiência e a estabilidade.' }
                ];
                const chartData = {
                    labels: ['Hidrelétrica', 'Termelétrica', 'Eólica', 'Solar', 'Nuclear & Outras'],
                    data: [62, 20, 11, 5, 2],
                    colors: ['#06b6d4', '#64748b', '#38bdf8', '#facc15', '#a8a29e']
                };
                return {
                    getGenerationData: () => [...generationData],
                    getComponentsData: () => [...componentsData],
                    getChartData: () => ({ ...chartData })
                };
            }
            return { getInstance: () => (instance || (instance = createInstance())) };
        })();

        // --- 2. CONTROLLER ---
        // Responsabilidade: Orquestrar a interação entre Model e View. (SRP)
        class ElectricalSystemController {
            constructor(model) {
                this.model = model;
                this.state = { activeSection: null, activeTab: 0, activeComponent: null };
                this.subscribers = [];
            }
            subscribe(callback) { this.subscribers.push(callback); }
            notifySubscribers() { this.subscribers.forEach(callback => callback(this.state)); }
            setState(newState) {
                this.state = { ...this.state, ...newState };
                this.notifySubscribers();
            }
            navigateToSection(section) {
                const newSection = this.state.activeSection === section ? null : section;
                this.setState({ activeSection: newSection });
            }
            selectTab(index) { this.setState({ activeTab: index }); }
            selectComponent(index) { this.setState({ activeComponent: index }); }
            getGenerationData() { return this.model.getGenerationData(); }
            getComponentsData() { return this.model.getComponentsData(); }
            getChartData() { return this.model.getChartData(); }
            getCurrentState() { return { ...this.state }; }
        }

        // --- 3. VIEW ---
        // Responsabilidade: Renderizar a UI e delegar eventos ao Controller. (SRP)
        const AppView = {
            init(rootElement, controller) {
                this.root = rootElement;
                this.controller = controller;
                this.controller.subscribe(this.render.bind(this));
                this.render(this.controller.getCurrentState());
                this.setupGlobalEventListeners();
                this.handleInitialNavigation();
            },
            render(state) {
                this.root.innerHTML = `
                    ${this.renderHeader(state)}
                    <main class="container mx-auto px-4 md:px-8">
                        <div id="content-container" class="mt-4">
                            ${this.renderContentSections(state)}
                        </div>
                        ${this.renderComponentsSection(state)}
                    </main>
                    ${this.renderFooter()}
                `;
                if (state.activeSection === 'geracao') this.renderChart();
                this.bindDynamicEventListeners(state);
                this.setupScrollAnimations();
            },
            renderHeader(state) {
                const navItems = [
                    { key: 'geracao', title: '⚡ Geração', subtitle: 'Onde tudo começa' },
                    { key: 'transmissao', title: '🗼 Transmissão', subtitle: 'Levando energia longe' },
                    { key: 'distribuicao', title: '🏠 Distribuição', subtitle: 'Energia na sua porta' }
                ];
                return `
                    <header class="container mx-auto text-center p-4 md:p-8">
            			<img src="../assets/Logo_ONSInspira_1 1.png" alt="Logo ONS Inspira" class="mx-auto h-48 w-auto mb-4">
                        <h1 class="text-4xl md:text-5xl font-black mb-2 text-[--color-primary-dark]">O Caminho da Energia Elétrica</h1>
                        <p class="text-lg md:text-xl max-w-3xl mx-auto mb-8">Uma jornada interativa sobre como a eletricidade é gerada, transmitida e distribuída até chegar a você.</p>
                        <nav class="flex flex-col md:flex-row items-center justify-center text-center mb-8">
                            ${navItems.map((item, index) => `
                                <div class="main-nav-btn m-2 cursor-pointer p-4 rounded-lg hover:bg-cyan-100 transition-all duration-300 ${state.activeSection === item.key ? 'active' : ''}" data-section="${item.key}">
                                    <h2 class="text-2xl font-bold text-[--color-primary]">${item.title}</h2>
                                    <p>${item.subtitle}</p>
                                </div>
                                ${index < navItems.length - 1 ? `<div class="flow-arrow hidden md:block mx-4">→</div><div class="flow-arrow md:hidden my-2">↓</div>` : ''}
                            `).join('')}
                        </nav>
                    </header>`;
            },
            renderContentSections(state) {
                return `
                    <div class="content-section ${state.activeSection === 'geracao' ? 'active' : ''}">${this.renderGenerationSection(state)}</div>
                    <div class="content-section ${state.activeSection === 'transmissao' ? 'active' : ''}">${this.renderTransmissionSection()}</div>
                    <div class="content-section ${state.activeSection === 'distribuicao' ? 'active' : ''}">${this.renderDistributionSection()}</div>
                `;
            },
            renderGenerationSection(state) {
                const genData = this.controller.getGenerationData();
                const activeItem = genData[state.activeTab];
                return `
                    <section class="rounded-xl shadow-lg p-6 md:p-8 mb-8 border bg-[--color-bg-card] border-[--color-border]">
                        <h3 class="text-3xl font-bold mb-4 text-[--color-primary-dark]">1. Geração de Energia Elétrica</h3>
                        <p class="mb-6">Esta é a primeira etapa, onde a energia é produzida a partir de diversas fontes. Explore os principais tipos de usinas e veja uma representação de como elas compõem nossa matriz energética.</p>
                        <div class="flex flex-col lg:flex-row gap-8">
                            <div class="lg:w-1/2">
                                <div class="flex flex-wrap gap-2 mb-4 border-b pb-2 border-[--color-border]">
                                    ${genData.map((item, index) => `<button class="tab-btn px-4 py-2 rounded-md text-sm font-medium transition-all duration-200 bg-slate-200 hover:bg-cyan-500 hover:text-white ${state.activeTab === index ? 'active' : ''}" data-tab-index="${index}">${item.name}</button>`).join('')}
                                </div>
                                <div class="p-4 rounded-lg min-h-[200px] bg-[--color-bg-card-alt]"><p>${activeItem?.description || 'Selecione um tipo de geração.'}</p></div>
                            </div>
                            <div class="lg:w-1/2 flex flex-col items-center">
                                <h4 class="text-xl font-semibold text-center mb-4">Exemplo de Matriz Energética</h4>
                                <div class="chart-container relative w-full max-w-sm mx-auto h-72 md:h-80"><canvas id="energyChart"></canvas></div>
                            </div>
                        </div>
                    </section>`;
            },
            renderTransmissionSection() {
                return `<section class="rounded-xl shadow-lg p-6 md:p-8 mb-8 border bg-[--color-bg-card] border-[--color-border]">
                        <h3 class="text-3xl font-bold mb-4 text-[--color-primary-dark]">2. Transmissão de Energia</h3>
                        <p class="mb-6">Após ser gerada, a energia precisa viajar grandes distâncias. Esta seção detalha como esse transporte é feito de forma eficiente e segura.</p>
                        <div class="space-y-4">
                           <div class="p-4 rounded-lg bg-[--color-bg-card-alt]"><strong>Altas Tensões:</strong> Para reduzir perdas, a energia é transmitida em tensões muito elevadas, permitindo transportar mais energia com menos desperdício.</div>
                           <div class="p-4 rounded-lg bg-[--color-bg-card-alt]"><strong>Linhas de Transmissão:</strong> São as grandes torres e cabos que levam a eletricidade por todo o país.</div>
                           <div class="p-4 rounded-lg bg-[--color-bg-card-alt]"><strong>Subestações de Transmissão:</strong> Usam transformadores para elevar a tensão na saída das usinas e rebaixá-la perto das cidades.</div>
                        </div>
                    </section>`;
            },
            renderDistributionSection() {
                return `<section class="rounded-xl shadow-lg p-6 md:p-8 mb-8 border bg-[--color-bg-card] border-[--color-border]">
                        <h3 class="text-3xl font-bold mb-4 text-[--color-primary-dark]">3. Distribuição de Energia</h3>
                        <p class="mb-6">Esta é a etapa final da jornada, onde a energia elétrica é entregue aos consumidores em tensões seguras e utilizáveis.</p>
                        <div class="space-y-4">
                           <div class="p-4 rounded-lg bg-[--color-bg-card-alt]"><strong>Redução de Tensão:</strong> Transformadores em subestações de distribuição reduzem a tensão para níveis utilizáveis e seguros.</div>
                           <div class="p-4 rounded-lg bg-[--color-bg-card-alt]"><strong>Redes de Distribuição:</strong> São os cabos e postes nas cidades que levam a energia até os transformadores de rua e, daí, para os consumidores.</div>
                           <div class="p-4 rounded-lg bg-[--color-bg-card-alt]"><strong>Consumo Final:</strong> A energia chega em residências, comércios e indústrias, pronta para ser utilizada.</div>
                        </div>
                    </section>`;
            },
            renderComponentsSection(state) {
                const compData = this.controller.getComponentsData();
                const activeItem = compData[state.activeComponent];
                return `
                    <section class="rounded-xl shadow-lg p-6 md:p-8 mt-12 border bg-[--color-bg-card] border-[--color-border]">
                        <h3 class="text-3xl font-bold text-center mb-2 text-[--color-primary-dark]">4. Componentes Chave</h3>
                        <p class="mb-8 text-center max-w-3xl mx-auto">Clique nos botões para conhecer a função de cada equipamento.</p>
                        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 md:gap-4 mb-6">
                            ${compData.map((item, index) => `<button class="component-btn p-3 text-center rounded-lg bg-slate-100 hover:bg-cyan-600 hover:text-white font-semibold ${state.activeComponent === index ? 'active' : ''}" data-component-index="${index}">${item.name}</button>`).join('')}
                        </div>
                        <div class="p-6 rounded-lg min-h-[100px] bg-[--color-primary-light] text-[--color-primary-dark]">
                            ${activeItem ? `<div><h4 class="font-bold text-lg mb-2">${activeItem.name}</h4><p>${activeItem.description}</p></div>` : `<p class="text-center">Selecione um componente para ver sua descrição.</p>`}
                        </div>
                    </section>`;
            },
            renderFooter() {
                return `
                    <footer class="text-center mt-12 pb-8 text-sm">
                        <p>Aplicação Interativa desenvolvida para fins educacionais pela UFF e ONS.</p>
                        <p>Desenvolvido por: Pedro Victor Rodrigues Veras. Versão Astro+JS.</p>
                    </footer>`;
            },
            renderChart() {
                const canvas = document.getElementById('energyChart');
                if (!canvas || typeof Chart === 'undefined') return;
                if (canvas.chartInstance) canvas.chartInstance.destroy();
                const chartData = this.controller.getChartData();
                canvas.chartInstance = new Chart(canvas.getContext('2d'), { type: 'doughnut', data: { labels: chartData.labels, datasets: [{ data: chartData.data, backgroundColor: chartData.colors, borderColor: 'var(--color-bg-card)', borderWidth: 3 }] }, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom', labels: { font: { size: 12, family: 'Inter' } } }, tooltip: { callbacks: { label: (ctx) => `${ctx.label || ''}: ${ctx.parsed || 0}%` } } } } });
            },
            setupGlobalEventListeners() {
                window.addEventListener('scroll', () => {
                    const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
                    if (scrollableHeight <= 0) {
                        document.body.style.background = 'white';
                        return;
                    };
                    const scrollPercent = window.scrollY / scrollableHeight;
                    const r = 255 - 29 * scrollPercent; // 255 -> 226
                    const g = 255 - 23 * scrollPercent; // 255 -> 232
                    const b = 255 - 15 * scrollPercent; // 255 -> 240
                    document.body.style.background = `linear-gradient(180deg, rgb(${r}, ${g}, ${b}) 0%, #f8fafc 100%)`;
                }, { passive: true });
                window.addEventListener('hashchange', () => this.handleInitialNavigation());
            },
            bindDynamicEventListeners(state) {
                this.root.querySelectorAll('.main-nav-btn').forEach(btn => btn.onclick = (e) => {
                    const section = e.currentTarget.dataset.section;
                    this.controller.navigateToSection(section);
                    window.location.hash = this.controller.getCurrentState().activeSection ? section : '';
                });
                this.root.querySelectorAll('.tab-btn').forEach(btn => btn.onclick = (e) => this.controller.selectTab(parseInt(e.currentTarget.dataset.tabIndex)));
                this.root.querySelectorAll('.component-btn').forEach(btn => btn.onclick = (e) => this.controller.selectComponent(parseInt(e.currentTarget.dataset.componentIndex)));
            },
            setupScrollAnimations() {
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add('is-visible');
                            observer.unobserve(entry.target);
                        }
                    });
                }, { threshold: 0.1 });
                this.root.querySelectorAll('section, nav, footer').forEach(el => {
                    el.classList.add('animate-on-scroll');
                    observer.observe(el);
                });
            },
            handleInitialNavigation() {
                const hash = window.location.hash.replace('#', '');
                const validSections = ['geracao', 'transmissao', 'distribuicao'];
                this.controller.setState({ activeSection: validSections.includes(hash) ? hash : null });
            }
        };

        // --- 4. Inicialização da Aplicação ---
        document.addEventListener('DOMContentLoaded', () => {
            if (typeof Chart === 'undefined') {
                console.error("Chart.js não foi carregado. O gráfico não funcionará.");
            }
            const model = ElectricalSystemModel.getInstance();
            const controller = new ElectricalSystemController(model);
            AppView.init(document.getElementById('app-root'), controller);
        });
    </script>
</body>
</html>

